# 复制为 .env.local（勿提交仓库）
# 快速初始化：npm run setup:env

# ── MiniMax（仅服务端 / 本地 proxy 使用，不进小程序包）──
MINIMAX_API_KEY=你的MiniMax密钥

# ── 小程序构建变量：LLM 中转地址 ──
# 本地联调（先 npm run dev:llm-proxy）：
TARO_APP_LLM_PROXY_URL=http://127.0.0.1:8787

# 上线 Vercel 部署 api/llm-proxy.js 后改为：
# TARO_APP_LLM_PROXY_URL=https://你的项目.vercel.app/api/llm-proxy

# ── 小程序构建变量：5000 道 catalog 云端根目录 ──
# 把仓库 catalog-cdn/ 上传到 CDN / 微信云存储后填这里（指向 meta.json 所在目录）：
# TARO_APP_CATALOG_BASE_URL=https://你的cdn域名/love-kitchen/catalog
# 留空则只用主包内置的 legacy 200 道（离线可用）。

# ── 小程序构建变量：临期提醒（订阅消息）──
# 公众平台申请的订阅消息模板 id + 服务端登记接口；留空则提醒开关显示"即将上线"
# TARO_APP_EXPIRY_TMPL_ID=你的模板id
# TARO_APP_REMINDER_API_URL=https://你的项目.vercel.app/api/reminder-register

# Vercel 环境变量（在 Vercel 控制台配置，非 .env.local）：
# MINIMAX_API_KEY=你的MiniMax密钥
# LLM_PROXY_SHARED_SECRET=可选共享密钥
# WX_APPID / WX_SECRET                      小程序凭证（临期推送用）
# UPSTASH_REDIS_REST_URL / _TOKEN           推送计划存储
# CRON_SECRET                               保护定时任务
